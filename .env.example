# Copia este archivo como .env y completa tus claves. .env NO se sube a git.

# --- LLM: openai (pago) | ollama (local, gratis) | fake (solo ensayo) ---
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- OpenAI (solo si LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0

# --- Langfuse Cloud (solo observabilidad) ---
# Settings > API Keys en https://cloud.langfuse.com (o https://us.cloud.langfuse.com si tu proyecto es de US)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Aplicación ---
DATABASE_URL=postgresql://spti:spti@localhost:5432/spti
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
AUTHZ_TIMEOUT_MS=50
# terminate (recomendado) | feedback
DENY_MODE=terminate
MAX_AGENT_STEPS=6
DEMO_MODE=true
